# Local outputs; keep review evidence on disk, not in the repository.
/tests/*.png
/tests/*.jpg
/tests/*.webp
/tests/*.html
*.zip
*.log
*.pyc
__pycache__/
.cache/
tmp/
reports/
.env
.env.*
*.secrets.json

# Root reports and obsolete local generators are not project entries.
/*-20*.md
/EDITION-*.md
/build-notifications-sql.mjs
/web-push/generate-secrets.mjs

# One maintained preview; other historical local copies are not submitted.
/tests/preview-server.mjs
/tests/release-preview.mjs
/tests/ui-consistency-preview.mjs
/tests/preview-fixture.js

# Build resources are admitted only by explicit manifest paths.
/assets/*
!/assets/.gitattributes
